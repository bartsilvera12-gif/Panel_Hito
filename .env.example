# Copiá este archivo a .env.local y completá los valores. NUNCA commitees .env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa Postgres (solo para migraciones/seed del lado servidor)
SUPABASE_DB_URL=

# Administrador inicial
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_USER_ID=

# Secreto para hashear IP (HMAC) en el formulario de contacto
IP_HASH_SECRET=
